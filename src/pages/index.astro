          <div class="ops-list">
            {recentOperations.map((entry, index) => {
              // Format ID like OP-014
              const opId = `OP-01${4 - index}`;
              const isFirst = index === 0;
              const statusText = isFirst ? 'COMPLETE' : 'COMPLETE'; // Usually from frontmatter, stubbed here
              
              return (
                <a href={`/ctf/${entry.slug}`} class="ops-item">
                  <span class="op-id">{opId}</span>
                  <span class="op-name">{entry.data.title.toUpperCase()}</span>
                  <span class="op-tags">
