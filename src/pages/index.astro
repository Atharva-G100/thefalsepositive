---
import Frame from '../theme/layouts/frame.astro';
import PostList from '../theme/layouts/widgets/post-list/PostList.astro';
import config from '../theme/config';
import { getPosts } from '../theme/assets/utils/posts';

const [writeups, blogPosts] = await Promise.all([getPosts('ctf'), getPosts('blog')]);
const latestPost = [...writeups, ...blogPosts].sort(
  (a, b) => (Date.parse(b.data.publishDate) || 0) - (Date.parse(a.data.publishDate) || 0),
)[0];
const description = 'Notes from security labs, CTFs, and things I’m figuring out.';
---

<Frame title={config.title} description={description} isHome>
  <section class="home-welcome" aria-labelledby="welcome-title">
    <h1 id="welcome-title">The False Positive</h1>
    <p>{description}</p>
    <nav class="welcome-links" aria-label="Explore posts">
      <a href="/ctf">Read writeups</a>
      <a href="/blog">Blog</a>
    </nav>
  </section>
  {latestPost && (
    <section class="latest-section" aria-label="Latest post">
      <p class="section-label">Latest post <span> / {latestPost.collection === 'ctf' ? 'Writeup' : 'Blog'}</span></p>
      <PostList posts={[latestPost]} />
    </section>
  )}
</Frame>

<style>
  .home-welcome, .latest-section { max-width: 800px; }
  h1 { margin-bottom: 20px; font-size: var(--ny-font-size-title); font-weight: 700; line-height: var(--ny-line-height-title); }
  .home-welcome p { color: var(--ny-color-text-muted); font-size: var(--ny-font-size-prose); line-height: var(--ny-line-height-prose); }
  .welcome-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 20px; font-size: var(--ny-font-size-prose-small); }
  .latest-section { margin-top: 36px; }
  .section-label { margin-bottom: 16px; color: var(--ny-color-text-muted); font-size: var(--ny-font-size-meta); }
  .section-label span { color: var(--ny-color-text-subtle); }
  .latest-section :global(.post-list) { margin-top: 0; }
</style>
