---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../theme/layouts/components/Tag.astro';
import { getCollection } from 'astro:content';
import { formatReadingTime } from '../../theme/assets/utils/reading-time';

export async function getStaticPaths() {
  const entries = await getCollection('ctf');
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const readingTime = formatReadingTime(remarkPluginFrontmatter.readingTimeMinutes);
const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Writeups', href: '/ctf' },
  { text: entry.data.title, href: `/ctf/${entry.slug}` },
];
---
<BaseLayout title={entry.data.title} description={entry.data.description} activePage="ctf" isPost headings={headings} breadcrumbs={breadcrumbs}>
  <article>
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="post-meta">Published: {entry.data.date} &nbsp;·&nbsp; Reading Time: {readingTime}</p>
    <div class="writeup-content"><Content /></div>
  </article>
  {entry.data.tags?.length > 0 && (
    <nav class="post-tags" aria-label="Post tags">
      <ul>{entry.data.tags.map(tag => <li><Tag href={`/ctf?tag=${encodeURIComponent(tag)}`} rel="tag">{tag}</Tag></li>)}</ul>
    </nav>
  )}
</BaseLayout>
<style>
  .page-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ny-space-2);
  }
  :global(.prose) .post-meta {
    color: var(--ny-color-text-subtle);
    font-size: var(--ny-font-size-meta);
    line-height: var(--ny-line-height-compact);
    margin-bottom: var(--ny-space-5);
  }
  .post-tags {
    --ny-tag-font-size: var(--ny-font-size-meta);
    margin-top: var(--ny-space-6);
    padding-top: var(--ny-space-4);
    border-top: 1px solid var(--ny-color-border);
  }
  :global(.prose) .post-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ny-space-2);
    padding-left: 0;
    list-style: none;
  }
  .post-tags li { min-width: 0; max-width: 100%; }
</style>
