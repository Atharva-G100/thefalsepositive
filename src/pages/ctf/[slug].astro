---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const ctfEntries = await getCollection("ctf");
  return ctfEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const DIFFICULTY_TAGS = ["Easy", "Medium", "Hard", "Insane", "easy", "medium", "hard", "insane"];
const tags = entry.data.tags || [];
const difficulty = tags.find(t => DIFFICULTY_TAGS.includes(t)) || null;
const category = tags.find(t => !DIFFICULTY_TAGS.includes(t)) || null;

const date = entry.data.date
  ? new Date(entry.data.date).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase()
  : null;

const buildVersion = Date.now().toString(36);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={entry.data.description ?? `CTF writeup: ${entry.data.title}`} />
  <title>{entry.data.title} | The False Positive</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href={`/styles/theme.css?v=${buildVersion}`} />
  <link rel="stylesheet" href={`/styles/ops.css?v=${buildVersion}`} />
  <link rel="stylesheet" href={`/styles/writeup.css?v=${buildVersion}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=JetBrains+Mono:wght@300;400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>

<div class="ops-page">

  <!-- SIDEBAR -->
  <aside class="sidebar-rail" aria-label="Primary Navigation">
    <a href="/" class="rail-logo" style="border:none;outline:none;">
      <img src="/assets/V_logo.png" alt="VALAK" />
    </a>
    <div class="rail-logo-divider"></div>
    <nav class="rail-nav">
      <a href="/" class="rail-nav-item"><span class="rail-nav-num">01</span><span class="rail-nav-label">HOME</span></a>
      <a href="/ctf" class="rail-nav-item active"><span class="rail-nav-num">02</span><span class="rail-nav-label">WRITEUPS</span></a>
      <a href="/pentest" class="rail-nav-item"><span class="rail-nav-num">03</span><span class="rail-nav-label">BLOG</span></a>
      <a href="/arsenal" class="rail-nav-item"><span class="rail-nav-num">04</span><span class="rail-nav-label">TOOLS</span></a>
      <a href="/news" class="rail-nav-item"><span class="rail-nav-num">05</span><span class="rail-nav-label">RESEARCH</span></a>
      <a href="/about" class="rail-nav-item"><span class="rail-nav-num">06</span><span class="rail-nav-label">ABOUT</span></a>
    </nav>
    <div class="rail-socials">
      <a href="https://github.com/Atharva-G100" class="rail-social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/atharva-gawas-valak/" class="rail-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:gawasatharva8@gmail.com" class="rail-social-link" aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15" height="15"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </a>
    </div>
  </aside>

  <!-- WRITEUP MAIN -->
  <main class="writeup-main">
    <div class="writeup-layout">

      <!-- ARTICLE -->
      <article class="writeup-article">
        <a href="/ctf" class="writeup-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Writeups
        </a>

        <header class="writeup-header">
          <div class="writeup-eyebrow">
            {entry.data.ctf && <span class="we-platform">{entry.data.ctf}</span>}
            {category && <><span class="we-sep"> / </span><span class="we-category">{category}</span></>}
            {difficulty && <><span class="we-sep"> / </span><span class={`we-difficulty we-diff-${difficulty.toLowerCase()}`}>{difficulty}</span></>}
            {date && <><span class="we-sep"> / </span><span class="we-date">{date}</span></>}
          </div>
          <h1 class="writeup-title">{entry.data.title}</h1>
          {entry.data.description && <p class="writeup-desc">{entry.data.description}</p>}
          <div class="writeup-divider"></div>
        </header>

        <div class="writeup-content prose">
          <Content />
        </div>
      </article>

      <!-- TOC -->
      {headings.length > 0 && (
        <aside class="writeup-toc">
          <div class="toc-inner">
            <div class="toc-label">TABLE OF CONTENTS</div>
            <nav class="toc-nav">
              {headings.map(h => (
                <a href={`#${h.slug}`} class={`toc-link toc-h${h.depth}`}>{h.text}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}

    </div>
  </main>
</div>

<script>
  const tocLinks = document.querySelectorAll(".toc-link");
  const headingEls = document.querySelectorAll(".writeup-content h1, .writeup-content h2, .writeup-content h3");
  if (tocLinks.length && headingEls.length) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove("active"));
          const id = entry.target.id;
          const active = document.querySelector(`.toc-link[href="#${id}"]`);
          if (active) active.classList.add("active");
        }
      });
    }, { rootMargin: "-10% 0px -75% 0px" });
    headingEls.forEach(h => { if (h.id) observer.observe(h); });
  }
</script>

</body>
</html>
