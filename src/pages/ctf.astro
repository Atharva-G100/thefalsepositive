  <!-- MAIN -->
  <main class="ops-main">

    <!-- Page header -->
    <div class="ops-header">
      <div class="ops-eyebrow">WRITEUPS</div>
      <p class="ops-subtitle">Documented security research and CTF writeups.</p>
    </div>

    <!-- Filter bar -->
    <div class="ops-filter-bar">
      <select class="ops-filter-select" id="filter-platform">
        <option value="">PLATFORM</option>
        {platforms.map(p => <option value={p}>{p.toUpperCase()}</option>)}
      </select>
      <select class="ops-filter-select" id="filter-category">
        <option value="">CATEGORY</option>
        {categories.map(c => <option value={c}>{c.toUpperCase()}</option>)}
      </select>
      <select class="ops-filter-select" id="filter-difficulty">
        <option value="">DIFFICULTY</option>
        {difficulties.map(d => <option value={d}>{d.toUpperCase()}</option>)}
      </select>
      <select class="ops-filter-select" id="filter-status">
        <option value="">STATUS</option>
        <option value="complete">COMPLETE</option>
      </select>
      <div class="ops-search-wrapper">
        <input type="text" class="ops-search" id="search-input" placeholder="SEARCH..." autocomplete="off" />
        <svg class="ops-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
    </div>

    <!-- Table -->
    <div class="ops-table-wrapper">
      <!-- Header row -->
      <div class="ops-table-head">
        <span class="col-id">#</span>
        <span class="col-name">Title</span>
        <span class="col-platform">Platform</span>
        <span class="col-category">Category</span>
        <span class="col-difficulty">Difficulty</span>
        <span class="col-date">Date</span>
        <span class="col-status">Status</span>
        <span class="col-arrow"></span>
      </div>

      <!-- Data rows -->
      <div class="ops-table-body" id="ops-table-body">
        {sortedWriteups.map(({ entry, id, difficulty, category, formattedDate }) => (
          <a
            href={`/ctf/${entry.slug}`}
            class="ops-row"
            data-platform={entry.data.ctf || ""}
            data-category={category}
            data-difficulty={difficulty}
            data-title={entry.data.title}
          >
            <span class="col-id op-id">{id}</span>
            <span class="col-name op-name">{entry.data.title.toUpperCase()}</span>
            <span class="col-platform op-platform">{(entry.data.ctf || "—").toUpperCase()}</span>
            <span class="col-category op-category">{category.toUpperCase()}</span>
            <span class="col-difficulty op-difficulty">{difficulty.toUpperCase()}</span>
            <span class="col-date op-date">{formattedDate}</span>
            <span class="col-status op-status">COMPLETE</span>
            <span class="col-arrow op-arrow">&rarr;</span>
          </a>
        ))}

        <!-- Empty state -->
        <div class="ops-empty" id="ops-empty" style="display:none;">
          <span>NO OPERATIONS MATCH CURRENT FILTERS</span>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
  const platformFilter = document.getElementById('filter-platform') as HTMLSelectElement;
  const categoryFilter = document.getElementById('filter-category') as HTMLSelectElement;
  const difficultyFilter = document.getElementById('filter-difficulty') as HTMLSelectElement;
  const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const rows = document.querySelectorAll('.ops-row') as NodeListOf<HTMLElement>;
  const emptyState = document.getElementById('ops-empty') as HTMLElement;

  function applyFilters() {
    const platform = platformFilter.value.toLowerCase();
    const category = categoryFilter.value.toLowerCase();
    const difficulty = difficultyFilter.value.toLowerCase();
    const search = searchInput.value.toLowerCase();

    let visibleCount = 0;

    rows.forEach(row => {
      const rowPlatform = (row.dataset.platform || '').toLowerCase();
      const rowCategory = (row.dataset.category || '').toLowerCase();
      const rowDifficulty = (row.dataset.difficulty || '').toLowerCase();
      const rowTitle = (row.dataset.title || '').toLowerCase();

      const matchPlatform = !platform || rowPlatform === platform.toLowerCase() || rowPlatform.includes(platform);
      const matchCategory = !category || rowCategory === category;
      const matchDifficulty = !difficulty || rowDifficulty === difficulty;
      const matchSearch = !search || rowTitle.includes(search);

      const visible = matchPlatform && matchCategory && matchDifficulty && matchSearch;
      row.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
  }

  platformFilter.addEventListener('change', applyFilters);
  categoryFilter.addEventListener('change', applyFilters);
  difficultyFilter.addEventListener('change', applyFilters);
  statusFilter.addEventListener('change', applyFilters);
  searchInput.addEventListener('input', applyFilters);
</script>

</body>
</html>


