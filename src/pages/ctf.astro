---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../theme/layouts/widgets/post-list/PostList.astro';
import Input from '../theme/layouts/components/Input.astro';
import CoverImage from '../theme/layouts/components/Image.astro';
import ctfCover from '../assets/writeups-ctf-night.png';
import machinesCover from '../assets/writeups-machines-night.png';
import { getPosts } from '../theme/assets/utils/posts';

const posts = (await getPosts()).sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate));
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
const ctfPosts = posts.filter(post => post.data.category === 'ctf');
const machinePosts = posts.filter(post => post.data.category === 'machine');
const eventNames = [...new Set(ctfPosts.map(post => post.data.ctf?.trim() || 'Other'))];
const events = eventNames.map(name => ({
  category: 'ctf', name, label: name, categoryLabel: 'CTFs',
  posts: ctfPosts.filter(post => (post.data.ctf?.trim() || 'Other') === name),
}));
const groups = [
  ...events,
  { category: 'machine', name: '', label: 'Machines', categoryLabel: 'Machines', posts: machinePosts },
];
const categories = [
  { value: 'ctf', label: 'CTFs', cover: ctfCover, count: ctfPosts.length },
  { value: 'machine', label: 'Machines', cover: machinesCover, count: machinePosts.length },
];
const coverWavePath = 'M0 40 C167 0 333 0 500 40 S833 80 1000 40 S1333 0 1500 40 S1833 80 2000 40 V144 H0 Z';
const browseHref = (category: string, group?: string) => {
  const params = new URLSearchParams({ category });
  if (group) params.set('group', group);
  return `/ctf?${params}`;
};
---
<BaseLayout title="Writeups" activePage="ctf" description="CTF competition writeups and machine walkthroughs.">
  <h1 id="archive-title">Writeups</h1>
  <p id="archive-description">Browse CTF competitions and machine walkthroughs.</p>

  <form id="archive-filters" role="search" aria-label="Search writeups">
    <Input id="writeup-filter" type="search" aria-label="Search writeups" placeholder="Search title, tag or event..." />
    <select id="filter-tag" aria-label="Tag"><option value="">All tags</option>{tags.map(tag => <option>{tag}</option>)}</select>
    <button type="reset">Clear</button>
  </form>

  <nav id="archive-path" aria-label="Writeup hierarchy" hidden>
    <a href="/ctf" data-archive-link>All writeups</a>
    <span id="category-path" hidden> / <a id="category-crumb" href="/ctf" data-archive-link></a></span>
    <span id="group-path" hidden> / <span id="group-crumb" aria-current="page"></span></span>
  </nav>

  <div class="archive-status-row">
    <p id="archive-status" role="status">{posts.length} writeups</p>
    <button id="wave-motion-toggle" type="button" aria-controls="category-tiles" hidden>Play waves</button>
  </div>

  <div id="category-tiles" class="tile-grid" data-wave-motion="paused">
    {categories.map(category => (
      <a class="category-cover-link" href={browseHref(category.value)} data-archive-link data-category={category.value} data-category-label={category.label}>
        <div class="cover-art">
          <CoverImage src={category.cover} alt="" ratio="16 / 9" lightbox={false} />
          <div class="cover-footer">
            <svg class="cover-wave" viewBox="0 0 1000 112" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <g class="cover-wave-layer cover-wave-back"><path d={coverWavePath} transform="translate(0 -8)" /></g>
              <g class="cover-wave-layer cover-wave-middle"><path d={coverWavePath} /></g>
              <g class="cover-wave-layer cover-wave-front"><path d={coverWavePath} transform="translate(0 12)" /></g>
            </svg>
            <h2>{category.label}</h2>
            <span class="cover-count">{category.count} {category.count === 1 ? 'writeup' : 'writeups'}</span>
          </div>
        </div>
      </a>
    ))}
  </div>

    <div id="ctf-events" class="event-list" hidden>
      {events.map(event => (
        <a class="event-link" href={browseHref('ctf', event.name)} data-archive-link>
          <span class="event-name">{event.label}</span>
          <span class="event-count">{event.posts.length} {event.posts.length === 1 ? 'writeup' : 'writeups'}</span>
        </a>
      ))}
    </div>

  <p id="archive-empty" hidden>No writeups match these filters.</p>
  <div id="writeup-lists" hidden>
    {groups.map(group => (
      <section class="writeup-group" data-category={group.category} data-group={group.name} data-group-label={group.label} data-category-label={group.categoryLabel} hidden>
        <header class="writeup-group-heading">
          {group.category === 'ctf' && <p class="group-category">{group.categoryLabel}</p>}
          <h2>{group.label}</h2>
        </header>
        <PostList posts={group.posts} />
      </section>
    ))}
  </div>
  <noscript>
    <p>All writeups:</p>
    <ul>{posts.map(post => <li><a href={post.href}>{post.data.title}</a></li>)}</ul>
  </noscript>
</BaseLayout>

<script>
  import { navigate as navigatePage } from 'astro:transitions/client';

  let archiveController: AbortController | undefined;
  function setupArchive() {
    archiveController?.abort();
    if (!document.querySelector('#archive-filters')) return;
    archiveController = new AbortController();
    const { signal } = archiveController;
    const form = document.querySelector<HTMLFormElement>('#archive-filters')!;
    const search = document.querySelector<HTMLInputElement>('#writeup-filter')!;
    const tag = document.querySelector<HTMLSelectElement>('#filter-tag')!;
    const title = document.querySelector<HTMLElement>('#archive-title')!;
    const description = document.querySelector<HTMLElement>('#archive-description')!;
    const categoryTiles = document.querySelector<HTMLElement>('#category-tiles')!;
    const waveMotionToggle = document.querySelector<HTMLButtonElement>('#wave-motion-toggle')!;
    let waveMotionChoice: string | null = null;
    try { waveMotionChoice = sessionStorage.getItem('writeup-wave-motion'); } catch {}
    function updateWaveMotion() {
      const playing = waveMotionChoice !== 'paused';
      categoryTiles.dataset.waveMotion = playing ? 'playing' : 'paused';
      waveMotionToggle.textContent = playing ? 'Pause waves' : 'Play waves';
    }
    waveMotionToggle.addEventListener('click', () => {
      waveMotionChoice = categoryTiles.dataset.waveMotion === 'playing' ? 'paused' : 'playing';
      try { sessionStorage.setItem('writeup-wave-motion', waveMotionChoice); } catch {}
      updateWaveMotion();
    }, { signal });
    updateWaveMotion();
    const categoryLinks = [...categoryTiles.querySelectorAll<HTMLAnchorElement>('[data-category]')];
    const events = document.querySelector<HTMLElement>('#ctf-events')!;
    const groups = [...document.querySelectorAll<HTMLElement>('.writeup-group')];
    const lists = document.querySelector<HTMLElement>('#writeup-lists')!;
    const empty = document.querySelector<HTMLElement>('#archive-empty')!;
    const status = document.querySelector<HTMLElement>('#archive-status')!;
    const path = document.querySelector<HTMLElement>('#archive-path')!;
    const categoryPath = document.querySelector<HTMLElement>('#category-path')!;
    const categoryCrumb = document.querySelector<HTMLAnchorElement>('#category-crumb')!;
    const groupPath = document.querySelector<HTMLElement>('#group-path')!;
    const groupCrumb = document.querySelector<HTMLElement>('#group-crumb')!;
    const baseTitle = document.title;

    function readState(url: URL) {
      const category = categoryLinks.find(link => link.dataset.category === url.searchParams.get('category'))?.dataset.category ?? '';
      const group = category === 'ctf' ? groups.find(group => group.dataset.category === category && group.dataset.group === url.searchParams.get('group'))?.dataset.group ?? '' : '';
      const requestedTag = url.searchParams.get('tag') ?? '';
      return {
        category,
        group,
        q: url.searchParams.get('q') ?? '',
        tag: [...tag.options].some(option => option.value === requestedTag) ? requestedTag : '',
      };
    }
    let state = readState(new URL(location.href));

    function render() {
      search.value = state.q;
      tag.value = state.tag;
      const selectedCategory = categoryLinks.find(link => link.dataset.category === state.category);
      const selectedGroup = state.group ? groups.find(group => group.dataset.category === state.category && group.dataset.group === state.group) : undefined;
      const categoryLabel = selectedCategory?.dataset.categoryLabel ?? '';
      const groupLabel = selectedGroup?.dataset.groupLabel ?? '';
      const filtering = Boolean(state.q.trim() || state.tag);
      const showingPosts = state.category === 'machine' || Boolean(state.group || filtering);
      const query = state.q.trim().toLowerCase();
      let count = 0;

      for (const group of groups) {
        const inScope = (!state.category || group.dataset.category === state.category) && (!state.group || group.dataset.group === state.group);
        let groupCount = 0;
        for (const post of group.querySelectorAll<HTMLElement>('.post-summary')) {
          const text = `${post.textContent} ${post.dataset.tags ?? ''} ${post.dataset.platform ?? ''} ${group.dataset.groupLabel} ${group.dataset.categoryLabel}`.toLowerCase();
          const matches = inScope && (!state.tag || JSON.parse(post.dataset.tags || '[]').includes(state.tag)) && text.includes(query);
          post.hidden = !matches;
          if (matches) groupCount++;
        }
        group.hidden = !showingPosts || groupCount === 0;
        group.querySelector<HTMLElement>('.writeup-group-heading')!.hidden = Boolean(state.group) || state.category === 'machine';
        count += groupCount;
      }

      categoryTiles.hidden = Boolean(state.category || showingPosts);
      waveMotionToggle.hidden = categoryTiles.hidden;
      events.hidden = showingPosts || state.category !== 'ctf';
      lists.hidden = !showingPosts;
      empty.hidden = !showingPosts || count > 0;
      empty.textContent = filtering ? 'No writeups match these filters.' : 'No writeups published here yet.';
      title.textContent = groupLabel || categoryLabel || 'Writeups';
      description.textContent = state.group
        ? 'Challenge writeups from this competition.'
        : state.category === 'ctf' ? 'Choose a competition to browse its writeups.'
        : state.category === 'machine' ? 'Machine walkthroughs and lab notes.'
        : 'Browse CTF competitions and machine walkthroughs.';
      document.title = groupLabel || categoryLabel ? `${groupLabel || categoryLabel} | ${baseTitle}` : baseTitle;

      path.hidden = !state.category && !filtering;
      categoryPath.hidden = !state.category;
      categoryCrumb.textContent = categoryLabel;
      categoryCrumb.href = `/ctf?${new URLSearchParams({ category: state.category })}`;
      if (!state.group) categoryCrumb.setAttribute('aria-current', 'page');
      else categoryCrumb.removeAttribute('aria-current');
      groupPath.hidden = !state.group;
      groupCrumb.textContent = groupLabel;
      const grouping = !showingPosts && state.category === 'ctf' ? ` · ${events.querySelectorAll('.event-link').length} events` : '';
      status.textContent = `${count} ${count === 1 ? 'writeup' : 'writeups'}${grouping}`;
    }

    function navigate(url: URL) {
      void navigatePage(url.href).then(() => document.getElementById('archive-title')?.focus({ preventScroll: true }));
    }
    title.tabIndex = -1;
    document.querySelectorAll<HTMLAnchorElement>('[data-archive-link]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        navigate(new URL(link.href));
      }, { signal });
    });
    function updateFilters() {
      state.q = search.value;
      state.tag = tag.value;
      const url = new URL(location.href);
      if (state.q) url.searchParams.set('q', state.q);
      else url.searchParams.delete('q');
      if (state.tag) url.searchParams.set('tag', state.tag);
      else url.searchParams.delete('tag');
      history.replaceState(history.state, '', url);
      render();
    }
    form.addEventListener('submit', event => event.preventDefault(), { signal });
    form.addEventListener('input', updateFilters, { signal });
    form.addEventListener('reset', () => queueMicrotask(() => { if (!signal.aborted) updateFilters(); }), { signal });
    render();
  }
  setupArchive();
  document.addEventListener('astro:page-load', setupArchive);
  document.addEventListener('astro:before-swap', () => archiveController?.abort());
</script>

<style>
  #archive-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 24px 0 20px; }
  #archive-filters :global(input) { flex: 1 1 260px; min-width: 0; width: auto; height: 36px; font-size: var(--ny-font-size-meta); }
  select, button { font-family: var(--ny-font-ui); font-size: var(--ny-font-size-meta); line-height: var(--ny-line-height-ui); color: var(--ny-color-text-muted); background: var(--ny-color-surface-container); border: 1px solid var(--ny-color-border); border-radius: var(--ny-radius-sm); padding: 7px 10px; }
  button { cursor: pointer; }
  #archive-path { margin: 24px 0 16px; color: var(--ny-color-text-subtle); font-size: var(--ny-font-size-meta); line-height: var(--ny-line-height-prose); overflow-wrap: anywhere; }
  #archive-path a { color: var(--ny-color-text-muted); }
  #archive-status { margin: 16px 0; color: var(--ny-color-text-subtle); font-size: var(--ny-font-size-meta); }
  .archive-status-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  #wave-motion-toggle { padding: 4px 8px; background: transparent; border-color: transparent; }
  #wave-motion-toggle:hover { color: var(--ny-color-outline); }
  #wave-motion-toggle:focus-visible { outline: 2px solid var(--ny-color-outline); outline-offset: 2px; }
  .tile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 20px; }
  .category-cover-link { display: block; min-width: 0; text-decoration: none !important; }
  .cover-art { position: relative; overflow: hidden; border-radius: var(--ny-radius-md); background: var(--ny-color-surface); }
  .cover-art :global(nayuta-image) { display: block; width: 100%; border: 0; border-radius: 0; }
  .cover-art :global(nayuta-image[data-fixed-ratio] img) { object-position: center; }
  .cover-footer { position: relative; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: -1px; padding: 10px 18px 16px; background: var(--ny-color-surface-container); }
  .cover-wave { position: absolute; left: 0; bottom: calc(100% - 1px); width: 100%; height: 56px; overflow: hidden; pointer-events: none; }
  .cover-wave-layer { fill: var(--ny-color-surface-container); transform-box: fill-box; animation: cover-wave-drift 8.5s linear infinite; animation-play-state: paused; }
  #category-tiles[data-wave-motion="playing"] .cover-wave-layer { animation-play-state: running; }
  .cover-wave-back { fill: color-mix(in srgb, var(--ny-color-outline) 32%, var(--ny-color-surface-container)); opacity: 0.68; animation-duration: 4.5s; animation-delay: -1.2s; animation-direction: reverse; }
  .cover-wave-middle { fill: color-mix(in srgb, var(--ny-color-primary) 22%, var(--ny-color-surface-container)); opacity: 0.88; animation-duration: 6.5s; animation-delay: -3.4s; }
  .cover-wave-front { animation-delay: -5.7s; animation-direction: reverse; }
  @keyframes cover-wave-drift { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .cover-footer h2 { margin: 0; padding: 0; border: 0; color: var(--ny-color-text); font-size: var(--ny-font-size-heading); font-weight: 500; line-height: var(--ny-line-height-heading); }
  .cover-count { flex-shrink: 0; color: var(--ny-color-text-muted); font-size: var(--ny-font-size-ui-small); }
  .event-count { color: var(--ny-color-text-subtle); font-size: var(--ny-font-size-meta); }
  .category-cover-link:hover h2, .event-link:hover .event-name { color: var(--ny-color-outline); text-decoration: underline; text-underline-offset: 4px; }
  .category-cover-link:focus-visible, .event-link:focus-visible { outline: 2px solid var(--ny-color-outline); outline-offset: 4px; }
  .event-list { margin-top: 24px; border-top: 1px solid var(--ny-color-border); }
  .event-link { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--ny-color-border); text-decoration: none !important; }
  .event-name { font-size: var(--ny-font-size-prose); }
  .event-count { flex-shrink: 0; }
  .writeup-group + .writeup-group { margin-top: 40px; }
  .group-category { margin: 28px 0 8px; color: var(--ny-color-text-subtle); font-size: var(--ny-font-size-meta); }
  .writeup-group-heading h2 { margin-top: 0; }
  .writeup-group :global(.post-list) { margin-top: 20px; }
  #archive-title:focus { outline: none; }
  [hidden], :global(.post-summary[hidden]) { display: none !important; }
  @media (max-width: 600px) { .tile-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
