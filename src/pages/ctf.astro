---
import { getCollection } from "astro:content";

const allWriteups = await getCollection("ctf").catch(() => []);

const DIFFICULTY_TAGS = ["Easy", "Medium", "Hard", "Insane", "easy", "medium", "hard", "insane"];

const sortedWriteups = allWriteups
  .sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime())
  .map((entry, index, arr) => {
    const tags = entry.data.tags || [];
    const difficulty = tags.find(t => DIFFICULTY_TAGS.includes(t)) || "—";
    const category = tags.find(t => !DIFFICULTY_TAGS.includes(t)) || "—";
    const date = entry.data.date ? new Date(entry.data.date) : null;
    const formattedDate = date
      ? date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase()
      : "—";
    const id = String(arr.length - index).padStart(3, "0");
    return { entry, id, difficulty, category, formattedDate };
  });

const platforms = [...new Set(sortedWriteups.map(w => w.entry.data.ctf).filter(Boolean))];
const categories = [...new Set(sortedWriteups.map(w => w.category).filter(c => c !== "—"))];
const difficulties = ["Easy", "Medium", "Hard", "Insane"];

const buildVersion = Date.now().toString(36);
---
