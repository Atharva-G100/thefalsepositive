<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="About Atharva Gawas — Cybersecurity student, Jr. Penetration Tester, and CTF player based in Navi Mumbai." />
  <meta name="author" content="Atharva Gawas" />
  <title>About | The False Positive</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href={`/styles/theme.css?v=${buildVersion}`} />
  <link rel="stylesheet" href={`/styles/about.css?v=${buildVersion}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=JetBrains+Mono:wght@300;400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>

<div class="about-page">

  <!-- SIDEBAR RAIL -->
