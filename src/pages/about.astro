      </a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="about-main">

    <!-- HERO -->
    <section class="about-hero">
      <div class="about-hero-left">
        <div class="about-eyebrow">ABOUT</div>
        <h1 class="about-name">ATHARVA<br/>GAWAS</h1>
        <p class="about-tagline">Cybersecurity student &amp; practitioner<br/>focused on breaking, investigating,<br/>and understanding systems.</p>
        <div class="about-meta-row">
          <span class="about-meta-item">Jr. Penetration Tester</span>
          <span class="about-meta-dot">&middot;</span>
          <span class="about-meta-item">Navi Mumbai, India</span>
        </div>
        <div class="about-divider"></div>
        <p class="about-bio">I enjoy exploring how systems work, finding their weaknesses, and learning from every breakpoint. This site is where I document that journey.</p>
      </div>
      <div class="about-hero-right">
        <div class="portrait-container">
          <img src="/assets/About_bg.png" alt="Atharva Gawas" class="portrait-img" />
          <div class="bracket-tl"></div>
          <div class="bracket-br"></div>
        </div>
      </div>
    </section>

    <!-- ROW 1: 4-column info strip (reference design) -->
    <div class="about-strip">
      <!-- FOCUS -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8"/>
            <line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/>
            <line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/>
          </svg>
        </div>
        <div class="strip-title">Focus</div>
        <ul class="strip-list">
          <li>Offensive Security</li>
          <li>Digital Forensics</li>
          <li>Web Security</li>
          <li>Security Research</li>
        </ul>
      </div>
      <!-- CURRENTLY -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
          </svg>
        </div>
        <div class="strip-title">Currently</div>
        <ul class="strip-list">
          <li>Learning</li>
          <li>Building</li>
          <li>Investigating</li>
          <li>Automating</li>
        </ul>
      </div>
      <!-- PHILOSOPHY -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
        </div>
        <div class="strip-title">Philosophy</div>
        <p class="strip-philosophy">I break things<br/>to understand them.<br/>I document what I learn.<br/>I share to help<br/>others build.<br/><br/><em>"Trust nothing.<br/>Verify everything."</em></p>
      </div>
      <!-- THE ARCHIVE -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="strip-title">The Archive</div>
        <a href="/pentest" class="strip-archive-link">Pentest Notes <span class="arrow-icon">&rarr;</span></a>
        <a href="/ctf" class="strip-archive-link">CTF Writeups <span class="arrow-icon">&rarr;</span></a>
        <a href="/arsenal" class="strip-archive-link">Arsenal <span class="arrow-icon">&rarr;</span></a>
        <a href="/news" class="strip-archive-link">Intel / News <span class="arrow-icon">&rarr;</span></a>
      </div>
    </div>

    <!-- ROW 2: Tools, Languages, Certifications, CTF -->
    <div class="about-strip about-strip-row2">
      <!-- LANGUAGES -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <div class="strip-title">Languages</div>
        <ul class="strip-list">
          <li>Python</li>
          <li>C</li>
          <li>JavaScript</li>
          <li>Bash</li>
        </ul>
      </div>
      <!-- TOOLS -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </div>
        <div class="strip-title">Offensive Tools</div>
        <ul class="strip-list">
          <li>Burp Suite</li>
          <li>Metasploit</li>
          <li>Nmap</li>
          <li>OWASP ZAP</li>
          <li>Wireshark</li>
          <li>Ghidra</li>
        </ul>
      </div>
      <!-- CERTIFICATIONS -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
          </svg>
        </div>
        <div class="strip-title">Certifications</div>
        <ul class="strip-list">
          <li>THM: Jr. Penetration Tester</li>
          <li>APIsec Certified Practitioner</li>
          <li>Udemy: Applied Ethical Hacking</li>
          <li>Infosys: Pentesting with Metasploit</li>
          <li>Cisco: Intro to CyberSecurity</li>
        </ul>
      </div>
      <!-- CTF / OPERATIONS -->
      <div class="strip-column">
        <div class="strip-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <div class="strip-title">CTF &amp; Ops</div>
        <ul class="strip-list">
          <li>[3301] N0T F0UND</li>
          <li>Web Exploitation</li>
          <li>Forensics</li>
          <li>Privilege Escalation</li>
        </ul>
      </div>
    </div>

  </main>
</div>

</body>
</html>

