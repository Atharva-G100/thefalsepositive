---
import type { MarkdownHeading } from 'astro';
import Frame from '../theme/layouts/frame.astro';
import Prose from '../theme/layouts/components/Prose.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  extraCss?: string[];
  headings?: MarkdownHeading[];
  isPost?: boolean;
  prose?: boolean;
  breadcrumbs?: { text: string; href: string }[];
}
const {
  title, description, activePage = '', extraCss = [], headings = [],
  isPost = false, prose = extraCss.length === 0,
  breadcrumbs = activePage
    ? [{ text: 'Home', href: '/' }, { text: title, href: Astro.url.pathname }]
    : [{ text: 'Home', href: '/' }],
} = Astro.props;
---
<Frame title={title} description={description} isHome={!activePage} isPost={isPost} headings={headings} breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    {extraCss.map(href => <link rel="stylesheet" href={href} />)}
    {extraCss.length > 0 && <link rel="stylesheet" href="/styles/nayuta/legacy.css" />}
  </Fragment>
  {prose ? <Prose><slot /></Prose> : <div class="legacy-content"><slot /></div>}
</Frame>
