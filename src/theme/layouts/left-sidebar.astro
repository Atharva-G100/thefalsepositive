---
import SidebarFooter from './sidebar-footer.astro';
import ProfileCard from './widgets/ProfileCard.astro';

interface Props {
  withProfileCard?: boolean;
  withHeader?: boolean;
}

const {
  withProfileCard = true,
  withHeader = withProfileCard || Astro.slots.has('header'),
} = Astro.props;
---

<aside class="left-region" id="left-sidebar">
  {
    withHeader && (
      <header class="left-header">
        {withProfileCard && <ProfileCard />}
        <slot name="header" />
      </header>
    )
  }

  <div class="left-sidebar-content">
    <slot />
  </div>

  <SidebarFooter className="left-footer" />
</aside>

<style>
  .left-region {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .left-header {
    flex-shrink: 0;
  }

  .left-sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 6px;
  }
</style>
