<script>
  let cleanup: (() => void) | undefined;

  function setupMotion() {
    cleanup?.();
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    const seen = new WeakSet<Element>();
    const animations = new Set<Animation>();
    const observer = new IntersectionObserver(entries => {
      let order = 0;
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        if (seen.has(entry.target)) continue;
        seen.add(entry.target);
        if (preference.matches) continue;
        const animation = entry.target.animate([
          { opacity: 0, transform: 'translateY(10px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ], {
          duration: 350,
          delay: Math.min(order++ * 55, 165),
          easing: 'cubic-bezier(0.2, 0.65, 0.3, 1)',
          fill: 'backwards',
        });
        animations.add(animation);
        animation.addEventListener('finish', () => animations.delete(animation), { once: true });
      }
    }, { threshold: 0.08 });

    // Observe individual summaries, never the full article or sticky sidebars.
    document.querySelectorAll('.home-welcome, .post-summary, .category-cover-link, .event-link, .about-hero, .about-strip')
      .forEach(element => observer.observe(element));
    const stopAnimations = () => {
      if (preference.matches) {
        animations.forEach(animation => animation.cancel());
        animations.clear();
      }
    };
    preference.addEventListener('change', stopAnimations);
    cleanup = () => {
      observer.disconnect();
      animations.forEach(animation => animation.cancel());
      preference.removeEventListener('change', stopAnimations);
    };
  }

  setupMotion();
  document.addEventListener('astro:before-swap', () => cleanup?.());
  document.addEventListener('astro:after-swap', setupMotion);
</script>

<style is:global>
  .category-cover-link .cover-art,
  .event-link {
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }
  .category-cover-link .cover-art img,
  .post-cover-container img {
    transition: transform 220ms ease;
  }
  .social-buttons a {
    transition: transform 180ms ease, color 180ms ease, background-color 180ms ease;
  }
  .category-cover-link:focus-visible .cover-art {
    box-shadow: 0 0 0 1px var(--ny-color-outline);
  }
  @media (hover: hover) and (pointer: fine) {
    .category-cover-link:hover .cover-art { box-shadow: 0 0 0 1px var(--ny-color-outline); }
    .category-cover-link:hover .cover-art img,
    .post-summary:hover .post-cover-container img { transform: scale(1.025); }
    .event-link:hover { background-color: color-mix(in srgb, var(--ny-color-outline) 4%, transparent); }
    .social-buttons a:hover { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .category-cover-link .cover-art, .event-link,
    .category-cover-link .cover-art img, .post-cover-container img,
    .social-buttons a { transition: none; }
    .category-cover-link:hover .cover-art img,
    .post-summary:hover .post-cover-container img,
    .social-buttons a:hover { transform: none; }
  }
</style>
